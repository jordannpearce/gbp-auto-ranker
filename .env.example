# Signs session cookies. Change this in production.
DASHBOARD_SECRET=change-this-dashboard-secret

# Persist customers, users, agencies, and the email log. On Railway, mount a volume and point this at it.
DATA_DIR=./data

# Public URL used in confirmation, reset, and dashboard links inside emails.
APP_URL=http://127.0.0.1:4410

# Resend.com. Without an API key, emails are logged locally and confirm/reset links appear on screen.
RESEND_API_KEY=
RESEND_FROM=GBP Auto Ranker <beth.t@example.com>
