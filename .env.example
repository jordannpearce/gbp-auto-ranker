# Signs session cookies. Change this in production.
DASHBOARD_SECRET=change-this-dashboard-secret

# Persist customers, users, agencies, and the email log when DATABASE_URL is not set.
DATA_DIR=./data

# Railway Postgres. When set, the app uses Postgres instead of JSON files.
DATABASE_URL=

# Public URL used in confirmation, reset, and dashboard links inside emails.
APP_URL=http://127.0.0.1:4410

# Optional fallback. Prefer saving the API key and from-address on /dashboard/emails.
RESEND_API_KEY=
RESEND_FROM=GBP Auto Ranker <beth.t@example.com>
